# Database (local dev — matches docker-compose.yml)
DATABASE_URL=postgresql://papertrading:papertrading_secret@localhost:5433/paper_trading

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
ENCRYPTION_KEY=change-me-32-char-minimum-key!!

# Services
API_PORT=3000
WS_PORT=3001
API_URL=http://localhost:3000
WS_URL=ws://localhost:3001/ws

# Scheduler (MIS square-off 15:20 IST, CNC settlement midnight IST)
SCHEDULER_ENABLED=true

# Broker (Phase 4 — live trading)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# When true (default), live orders are simulated even after broker connect
LIVE_TRADING_SIMULATION=true
