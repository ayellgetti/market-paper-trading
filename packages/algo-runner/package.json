{
  "name": "@paper-trading/algo-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/runner.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/index.js"
    },
    "./runner": {
      "import": "./dist/runner.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/runner.ts",
    "start": "node dist/runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paper-trading/db": "workspace:*",
    "@paper-trading/oms": "workspace:*",
    "@paper-trading/strategy-sdk": "workspace:*",
    "dotenv": "^16.5.0",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
